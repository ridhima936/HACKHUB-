# URL of the HackHub API (backend). See .env.example for the backend vars.
#
# Local development:
#   VITE_API_URL=http://localhost:5000/api
#
# Production (set this in the Vercel project settings, NOT here):
#   VITE_API_URL=https://your-backend-host/api
#
# Note: Vite inlines this value at build time, so the frontend must be rebuilt
# after changing it. Never put secrets in a VITE_* variable - they end up in the
# public JavaScript bundle.
VITE_API_URL=http://localhost:5000/api

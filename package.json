{
  "name": "hackhub",
  "version": "1.0.0",
  "description": "HackHub - a student developer platform for projects, teams and AI-recommended hackathons (RAG over MongoDB Atlas Vector Search).",
  "main": "server.js",
  "private": true,
  "keywords": [
    "hackathon",
    "rag",
    "vector-search",
    "mongodb-atlas",
    "express",
    "react",
    "embeddings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridhima936/HACKHUB-.git"
  },
  "bugs": {
    "url": "https://github.com/ridhima936/HACKHUB-/issues"
  },
  "homepage": "https://github.com/ridhima936/HACKHUB-#readme",
  "author": "HackHub",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/hackathons.js && node seed/generateEmbeddings.js",
    "seed:data": "node seed/hackathons.js",
    "seed:embeddings": "node seed/generateEmbeddings.js",
    "create-index": "node seed/createVectorIndex.js",
    "install:all": "npm install && npm install --prefix frontend",
    "client": "npm run dev --prefix frontend",
    "build:client": "npm run build --prefix frontend",
    "lint:client": "npm run lint --prefix frontend",
    "check": "node scripts/check-syntax.js",
    "test": "node tests/vector.test.js",
    "test:unit": "node tests/vector.test.js",
    "test:api": "node tests/smoke.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2"
  }
}

# Copy to .env and fill in your own values. Never commit the real .env file.

# MongoDB connection string, including the database name.
# Atlas is needed for Vector Search; a local MongoDB works with the fallback search.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hackhub?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=5000

# Allowed frontend origins for CORS, comma-separated.
CLIENT_URL=http://localhost:5173

# Set to false to skip loading the embedding model at startup.
PRELOAD_MODEL=true

# Set to false to turn off the automatic hackathon sync from Devpost.
AUTO_SYNC=true

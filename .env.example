# ---------------------------------------------------------------------------
# HackHub backend environment.
# Copy this file to `.env` (same folder as server.js) and fill in your values.
#   cp .env.example .env
# NEVER commit the real `.env` - it is ignored by git.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Use MongoDB Atlas (recommended - it is required for Atlas Vector Search).
# Include the database name, e.g. mongodb+srv://user:pass@cluster.mongodb.net/hackhub
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hackhub?retryWrites=true&w=majority

# Any long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on.
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
# Local dev + your deployed frontend, e.g. http://localhost:5173,https://hackhub.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: set to false to skip downloading the embedding model on boot.
# (The RAG endpoint loads it lazily on first use either way.)
PRELOAD_MODEL=true

# Optional: set FORCE=1 when running `npm run seed:embeddings` to regenerate
# embeddings that already exist.
# FORCE=0
